# Copy to .env in your shell, or export these variables before running.
# Do not commit real passwords.

# --- Local SQLite (default if JDBC_URL is unset) ---
# JDBC_URL=jdbc:sqlite:materna.db

# --- Free hosted PostgreSQL (Neon, Supabase, etc.) ---
# JDBC_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# JDBC_USER=your_user
# JDBC_PASSWORD=your_password
#
# Neon/Supabase also give a postgres:// URL. Either form works:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Original McGill DB2 (no longer reachable after the course) ---
# JDBC_URL=jdbc:db2://winter2022-comp421.cs.mcgill.ca:50000/cs421
# JDBC_USER=your_socs_id
# JDBC_PASSWORD=your_socs_password
# SOCSUSER and SOCSPASSWD are still accepted as aliases.
